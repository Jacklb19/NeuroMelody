# Copiar este archivo a .env.local para desarrollo local (nunca versionar .env ni .env.local).
# Solo nombres de variables: los valores reales viven en .env.local y en las variables de entorno de Vercel.

# --- Cliente (Vite): se incrustan en el paquete público ---
# La clave anónima solo es segura porque todas las tablas tienen RLS activa.
VITE_APP_TITLE=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=

# --- Solo servidor (funciones de Vercel): jamás con prefijo VITE_ ---
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
